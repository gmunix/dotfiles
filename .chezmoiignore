# Source-only files.
README.md
.gitignore
tests

{{- $isDesktop := eq .machine.role "desktop" -}}
{{- $isLinuxDesktop := and $isDesktop (eq .chezmoi.os "linux") -}}
{{- $isCachyOS := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{- $isCachyOS = eq (.chezmoi.osRelease.id | default "") "cachyos" -}}
{{- end -}}
{{- $desktopProfile := index .machine "desktopProfile" | default "none" -}}
{{- $hyprlandEnabled := .features.hyprland | default false -}}
{{- $noctaliaEnabled := .features.noctalia | default false -}}
{{- $hyprland := and $hyprlandEnabled (eq $desktopProfile "hyprland") (has "arch-hyprland" .packages.groups) -}}
{{- $noctalia := and $hyprland $isCachyOS $noctaliaEnabled (has "cachyos-noctalia" .packages.groups) -}}
{{- $spicetify := .features.spicetify | default false -}}

{{- if not $isDesktop }}
.config/ghostty
{{- end }}

{{- if or (ne .chezmoi.os "darwin") (not $isDesktop) }}
.aerospace.toml
.config/sketchybar
{{- end }}

{{- if or (not $isLinuxDesktop) (not $hyprland) }}
.config/hypr
{{- end }}

{{- if or (not $isLinuxDesktop) (not $noctalia) }}
.config/noctalia
{{- end }}

{{- if or (not $isLinuxDesktop) (not $spicetify) }}
.config/spicetify
{{- end }}
