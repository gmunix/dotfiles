{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "work",
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.6-luna",
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    }
  },
  "permission": {
    "external_directory": {
      "*": "ask",
      "~/.agent-context": "allow",
      "~/.agent-context/**": "allow"
    }
  },
  "plugin": [
    "@mohak34/opencode-notifier@latest",
    "opencode-mermaid-renderer@0.0.1"
  ],
  "server": {
    "port": 4096,
    "hostname": "0.0.0.0"
  },
  "mcp": {
    "code-review-graph": {
      "type": "local",
      "command": ["code-review-graph", "serve"]
    },
    "Context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    }
  }
}
