{{- $role := promptChoiceOnce . "role" "Machine role" (list "desktop" "server") "desktop" -}}
{{- $homebrewPrefix := "/opt/homebrew" -}}
{{- $packageManager := "none" -}}
{{- $desktopProfile := "none" -}}
{{- $isArchLike := false -}}
{{- $isDebianLike := false -}}
{{- $isCachyOS := false -}}
{{- if eq .chezmoi.arch "amd64" -}}
{{- $homebrewPrefix = "/usr/local" -}}
{{- end -}}
{{- if eq .chezmoi.os "linux" -}}
{{- $osID := .chezmoi.osRelease.id | default "" -}}
{{- $osIDLike := .chezmoi.osRelease.idLike | default "" -}}
{{- $isCachyOS = eq $osID "cachyos" -}}
{{- $isArchLike = or (eq $osID "arch") $isCachyOS (contains "arch" $osIDLike) -}}
{{- $isDebianLike = or (eq $osID "debian") (eq $osID "ubuntu") (contains "debian" $osIDLike) (contains "ubuntu" $osIDLike) -}}
{{- end -}}
{{- if eq .chezmoi.os "darwin" -}}
{{- $packageManager = "brew" -}}
{{- else if and (eq .chezmoi.os "linux") $isArchLike -}}
{{- $packageManager = "pacman" -}}
{{- else if and (eq .chezmoi.os "linux") $isDebianLike -}}
{{- $packageManager = "apt" -}}
{{- else if eq .chezmoi.os "linux" -}}
{{- $packageManager = promptChoiceOnce . "packageManager" "Linux package manager" (list "apt" "pacman" "none") "none" -}}
{{- end -}}
{{- $isDesktop := eq $role "desktop" -}}
{{- $isLinuxDesktop := and $isDesktop (eq .chezmoi.os "linux") -}}
{{- if and $isLinuxDesktop $isCachyOS -}}
{{- $desktopProfile = promptChoiceOnce . "desktopProfile" "Linux desktop profile" (list "hyprland" "none") "hyprland" -}}
{{- end -}}
{{- $isHyprlandDesktop := and $isLinuxDesktop $isCachyOS (eq $desktopProfile "hyprland") -}}
{{- $isNoctaliaDesktop := $isHyprlandDesktop -}}
sourceDir = {{ .chezmoi.sourceDir | quote }}

[data.machine]
role = {{ $role | quote }}
hostname = {{ .chezmoi.hostname | quote }}
desktopProfile = {{ $desktopProfile | quote }}

[data.packages]
manager = {{ $packageManager | quote }}
groups = [
  "base",
  "nvim",
{{- if eq $role "desktop" }}
  "desktop",
{{- if eq .chezmoi.os "darwin" }}
  "macos-desktop",
{{- else if eq .chezmoi.os "linux" }}
  "linux-desktop",
{{- if $isHyprlandDesktop }}
  "arch-hyprland",
{{- end }}
{{- if $isNoctaliaDesktop }}
  "cachyos-noctalia",
{{- end }}
{{- end }}
{{- else if eq $role "server" }}
  "server",
{{- end }}
]

[data.paths]
notes = "~/Notes/zettelkasten"
homebrewPrefix = {{ $homebrewPrefix | quote }}
aerospaceBin = {{ printf "%s/bin/aerospace" $homebrewPrefix | quote }}
sketchybarBin = {{ printf "%s/bin/sketchybar" $homebrewPrefix | quote }}

[data.features]
hyprland = {{ $isHyprlandDesktop }}
noctalia = {{ $isNoctaliaDesktop }}
ddcutil = {{ $isHyprlandDesktop }}
spicetify = false
sunshine = false
starship = true

[data.features.nvim]
obsidian = {{ eq $role "desktop" }}
dadbod = {{ eq $role "desktop" }}
rest = {{ eq $role "desktop" }}
neogit = true
windsurf = {{ eq $role "desktop" }}
undoGlow = {{ eq $role "desktop" }}
milli = {{ eq $role "desktop" }}
milliSplash = ["shader", "lights", "ididnot"]
milliLoop = {{ eq $role "desktop" }}

[data.appearance.ghostty]
fontFamily = "JetBrainsMono Nerd Font"
fontSize = {{ if eq .chezmoi.os "darwin" }}14{{ else }}11{{ end }}
theme = {{ if $isNoctaliaDesktop }}"noctalia"{{ else }}"Gruvbox Dark Hard"{{ end }}

[data.appearance.nvim]
theme = {{ if $isNoctaliaDesktop }}"noctalia"{{ else }}"monokai"{{ end }}

[data.appearance.tmux]
theme = "gruvbox"
plugins = {{ and $isDesktop (ne $packageManager "none") }}
githubStatus = false

[data.linux]
hwmonPath = "/sys/class/hwmon/hwmon0/temp1_input"
hyprMonitors = [
  { mode = "preferred", position = "auto", scale = 1 },
]
