{{- $features := index . "features" | default dict -}}
{{- $machine := index . "machine" | default dict -}}
{{- $spicetify := index $features "spicetify" | default false -}}
{{- if and (eq .chezmoi.os "linux") (eq (index $machine "role" | default "server") "desktop") $spicetify -}}
#!/usr/bin/env bash
set -euo pipefail

spicetify_bin="$(command -v spicetify || true)"
if [[ -z "$spicetify_bin" && -x "$HOME/.spicetify/spicetify" ]]; then
  spicetify_bin="$HOME/.spicetify/spicetify"
fi

if [[ -z "$spicetify_bin" ]]; then
  printf 'Spicetify is not installed; skipping Colorful theme configuration.\n' >&2
  exit 0
fi

"$spicetify_bin" config current_theme Colorful color_scheme noctalia
"$spicetify_bin" config inject_css 1 replace_colors 1 overwrite_assets 1 inject_theme_js 1
"$spicetify_bin" apply
{{- end }}
