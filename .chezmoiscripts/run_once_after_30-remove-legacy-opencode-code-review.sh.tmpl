#!/bin/sh

set -eu

{{- $features := get . "features" | default dict }}
{{- $ai := get $features "ai" | default dict }}
{{- $opencode := true }}
{{- if hasKey $ai "opencode" }}{{ $opencode = get $ai "opencode" }}{{ end }}
{{- if $opencode }}
legacy_dir="{{ .chezmoi.homeDir }}/.config/opencode/skills/code-review"
legacy_file="$legacy_dir/SKILL.md"
expected="1c9066a24c37d5a59de8081277820f95ff50efc47fd9b8f45b4cc204f0e14e8e"

if [ -d "$legacy_dir" ] && [ ! -L "$legacy_dir" ] && [ -f "$legacy_file" ] && [ ! -L "$legacy_file" ]; then
  if command -v shasum >/dev/null 2>&1; then
    actual=$(shasum -a 256 "$legacy_file" | cut -d ' ' -f 1)
  elif command -v sha256sum >/dev/null 2>&1; then
    actual=$(sha256sum "$legacy_file" | cut -d ' ' -f 1)
  else
    actual=""
  fi

  if [ "$actual" = "$expected" ]; then
    rm "$legacy_file"
    rmdir "$legacy_dir" 2>/dev/null || true
  else
    printf 'chezmoi: preserving modified legacy skill at %s\n' "$legacy_file" >&2
  fi
fi
{{- end }}
